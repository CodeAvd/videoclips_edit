APP_ENV=development
APP_NAME=AI Shorts Engine Backend
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_shorts_engine
SQLALCHEMY_ECHO=false
DEPLOYMENT_LANGUAGE=en
AUTH_MODE=development_header
DEFAULT_DEV_ACTOR_ID=local-dev
DEFAULT_DEV_ROLE=admin
AUTH_SESSION_COOKIE_NAME=ai_shorts_session
AUTH_SESSION_SECRET=
AUTH_SESSION_ISSUER=ai-shorts-engine
AUTH_SESSION_MAX_AGE_SECONDS=43200
AUTH_WORKER_JWT_SECRET=
AUTH_WORKER_JWT_ISSUER=ai-shorts-engine-workers
AUTH_WORKER_REQUIRED_SCOPE=worker:internal
APP_BASE_URL=http://localhost:8000
STORAGE_BACKEND=filesystem
STORAGE_BUCKET=ai-shorts-engine
LOCAL_STORAGE_DIR=.data/storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
STORAGE_PRESIGN_EXPIRY_SECONDS=3600
ASR_PROVIDER_PRIMARY=stub
ASR_PROVIDER_FALLBACK=
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo
GROQ_BASE_URL=https://api.groq.com/openai/v1/audio/transcriptions
OPENAI_API_KEY=
OPENAI_ASR_MODEL=whisper-1
OPENAI_BASE_URL=https://api.openai.com/v1/audio/transcriptions
ASR_TIMEOUT_SECONDS=120
ASR_MAX_CHUNK_SECONDS=900
BROLL_ENABLED=false
AUTORESEARCH_ENABLED=false
OUTBOX_CLAIM_TTL_SECONDS=300
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=300
OUTBOX_MAX_RETRIES=5
